{
  "manifest_version": 3,
  "name": "FoxyCookieManager",
  "version": "1.6",
  "description": "Công cụ quản lý và đăng nhập nhanh bằng cookie Facebook/Instagram. Lưu trữ cục bộ, bảo mật, không gửi dữ liệu ra ngoài.",
  "homepage_url": "http://foxycrown.net/",

  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },

  "action": {
    "default_popup": "popup-new.html",
    "default_title": "FoxyCookieManager",
    "default_icon": {
      "16": "icon/icon16.png",
      "48": "icon/icon48.png",
      "128": "icon/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "cookies",
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.meta.com/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
